SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA FIRMS (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT

# Telegram bot token from @BotFather (leave empty to disable sending)
TELEGRAM_BOT_TOKEN=

# Optional PostgreSQL (SQLite is used when DB_NAME is empty)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Tuning (all optional, defaults shown)
# FIRMS_BBOX=69.2,39.1,80.3,43.3
# ALERT_RADIUS_KM=15
# ALERT_CLEAR_MINUTES=30
# PATH_FACTOR=1.3
# MUDFLOW_ASSUMED_SPEED_KMH=20
# OTP_EXPOSE_IN_DEBUG=True   # echo the login code in the API response while DEBUG=True (never in production)
